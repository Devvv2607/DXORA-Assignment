# Copy to .env and fill in. NEVER commit .env. Placeholders only in this file.

# ---------------------------------------------------------------- application
# Comma-separated, in any order (results always follow registry order).
# Core: mastodon,bluesky,telegram,devto,gist   Optional: wordpress,linkedin,discord
ENABLED_PLATFORMS=mastodon,bluesky,telegram,devto,gist
# true = never call any platform; every result is "DRY_RUN: not published" (never a fake success)
DRY_RUN=false
# IANA zone used for the "date"/"time" fields, e.g. UTC, Asia/Kolkata, Europe/Berlin
APP_TIMEZONE=UTC
LOG_LEVEL=INFO
PLATFORM_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15
# Set false to skip public-access checks (public_access will then always be false)
VERIFY_PUBLIC_ACCESS=true
# Per-IP limit on POST /posting (0 disables)
RATE_LIMIT_PER_MINUTE=20
# Optional: if set, POST /posting requires header "X-API-Key: <value>"
API_KEY=

# ---------------------------------------------------------------- Mastodon
# Instance URL (https). Token: <instance>/settings/applications -> New application, scope write:statuses
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ---------------------------------------------------------------- Bluesky
# Handle like yourname.bsky.social. App password: bsky.app -> Settings -> Privacy and security -> App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Your PDS; leave as is for normal bsky.social accounts
BLUESKY_SERVICE_URL=https://bsky.social

# ---------------------------------------------------------------- Telegram
# Token from @BotFather (/newbot). The bot must be an ADMIN of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=
# Public channel username, with or without @ (e.g. my_test_channel)
TELEGRAM_CHANNEL_USERNAME=

# ---------------------------------------------------------------- Dev.to
# https://dev.to/settings/extensions -> "DEV Community API Keys" -> Generate API key
DEVTO_API_KEY=
# Up to 4 lowercase alphanumeric tags
DEVTO_TAGS=automation,api,python

# ---------------------------------------------------------------- GitHub Gist
# https://github.com/settings/tokens -> classic token with only the "gist" scope
# (or fine-grained token with "Gists: Read and write" account permission)
GITHUB_TOKEN=

# ---------------------------------------------------------------- optional: WordPress
# Public HTTPS site; Users -> Profile -> Application Passwords
WP_SITE_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# ---------------------------------------------------------------- optional: LinkedIn
# Developer app with "Share on LinkedIn" (w_member_social). URN e.g. urn:li:person:<id>
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# YYYYMM of an active LinkedIn API version
LINKEDIN_VERSION=202510

# ---------------------------------------------------------------- optional: Discord
# Server Settings -> Integrations -> Webhooks -> Copy URL (treat as a secret)
DISCORD_WEBHOOK_URL=
# Server ID (User Settings -> Advanced -> Developer Mode, then right-click server -> Copy Server ID)
DISCORD_GUILD_ID=
